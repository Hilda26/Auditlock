{
  "name": "auditlock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3015",
    "prebuild": "node scripts/export-proof.mjs",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test:contracts": "python -m pytest tests/direct -q",
    "deploy:contract": "node scripts/deploy.mjs",
    "test:live": "node scripts/verify-live.mjs",
    "test:hosted": "node scripts/verify-hosted.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
